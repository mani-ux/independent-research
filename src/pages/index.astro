---
import Layout from '../layouts/Layout.astro';
import { career, profile } from '../data/career';
---
<Layout>
  <section class="intro" aria-labelledby="intro-title">
    <div class="intro-top"><p class="eyebrow">Product Design & Strategy Leader</p><span class="edition">A personal portfolio</span></div>
    <h1 id="intro-title">Manivannan<span class="surname">Kalyanasundaram<span class="accent">.</span></span></h1>
    <div class="intro-bottom"><p>Making complex things<br /><em>feel human.</em></p><div class="intro-note"><p>From shaping experiences to leading<br class="desktop-break" /> teams, products, and systems.</p><a href="#career">Explore my career <span aria-hidden="true">↓</span></a></div></div>
  </section>

  <section class="career" id="career" aria-labelledby="career-title">
    <div class="career-intro"><div class="sticky-intro"><p class="eyebrow"><span class="section-number">01 /</span> Career journey</p><h2 id="career-title">The path<br /><em>so far.</em></h2><p class="career-context">Design craft. Systems thinking.<br />People and product leadership.</p><span class="year-span">2010 <span aria-hidden="true">⟶</span> Now</span></div></div>
    <ol class="timeline" aria-label="Career history, most recent first">
      {career.map((entry, index) => <li class:list={['career-entry', {current:entry.current}]}>
        <div class="entry-meta"><span class="entry-index" aria-hidden="true">{String(career.length - index).padStart(2,'0')}</span><span class="entry-dates"><time datetime={entry.startDate}>{entry.start}</time><span aria-hidden="true"> — </span><span class="sr-only"> to </span>{entry.endDate ? <time datetime={entry.endDate}>{entry.end}</time> : <span>{entry.end}</span>}</span>{entry.current && <span class="current-label"><span aria-hidden="true"></span> Current</span>}</div>
        <div class="entry-content"><h3>{entry.company}</h3><p class="entry-role">{entry.role}</p>{entry.organization !== entry.company && <p class="organization">{entry.organization}</p>}<p class="location">{entry.location}</p>{entry.summary && <p class="entry-summary">{entry.summary}</p>}{entry.focus.length > 0 && <ul class="focus-list" aria-label="Areas of work">{entry.focus.map(focus=><li>{focus}</li>)}</ul>}</div>
      </li>)}
    </ol>
  </section>
</Layout>
