---
import Layout from '../layouts/Layout.astro';
import PublicationList from '../components/PublicationList.astro';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---
<Layout>
  <section class="hero"><p class="eyebrow">An independent research & editorial platform</p><h1>Exploring how design<br />shapes what comes next.</h1><p class="intro">Inquiry into strategic design, artificial intelligence, design systems, and organizational transformation.</p><a class="text-link" href={`${base}/about/`}>About the publication <span aria-hidden="true">↗</span></a></section>
  <section class="latest"><div class="section-title"><h2>From the publication</h2><span class="eyebrow">Research & writing</span></div><PublicationList /></section>
</Layout>
