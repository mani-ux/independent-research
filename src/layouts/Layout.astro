---
import '../styles/global.css';
const { title = 'Independent Research', description = 'Independent inquiry into strategic design, artificial intelligence, design systems, and organizational transformation.' } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const links = [['Research', '/research/'], ['Writing', '/writing/'], ['About', '/about/']];
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <link rel="canonical" href={new URL(Astro.url.pathname, Astro.site)} />
    <title>{title === 'Independent Research' ? title : `${title} — Independent Research`}</title>
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <header class="shell"><a class="brand" href={`${base}/`}>Independent<br />Research<span class="brand-dot">.</span></a>
      <nav aria-label="Main navigation">{links.map(([label, href]) => <a href={`${base}${href}`} aria-current={Astro.url.pathname.startsWith(`${base}${href}`) ? 'page' : undefined}>{label}</a>)}</nav>
    </header>
    <main id="main" class="shell"><slot /></main>
    <footer class="shell"><span>Independent Research</span><span>Strategic design · AI · Organizations</span></footer>
  </body>
</html>
