---
import '../styles/global.css';
import { profile } from '../data/career';
const { title = profile.name, description = 'The career journey of Manivannan Kalyanasundaram, Product Design & Strategy Leader.' } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#ffffff" />
    <link rel="canonical" href={new URL(Astro.url.pathname, Astro.site)} />
    <title>{title === profile.name ? `${title} — Design & Strategy` : `${title} — ${profile.name}`}</title>
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <header class="site-header shell">
      <a class="wordmark" href={`${base}/`} aria-label={`${profile.name}, home`}><span class="monogram" aria-hidden="true">mk<span>·</span></span><span class="wordmark-name">Manivannan<br />Kalyanasundaram</span></a>
      <nav aria-label="Main navigation"><a class="nav-career" href={`${base}/#career`}>Career</a><a href={`${base}/research/`} aria-current={Astro.url.pathname.includes('/research/') ? 'page' : undefined}>Research & Studies</a><a href={`${base}/perspectives/`} aria-current={Astro.url.pathname.includes('/perspectives/') ? 'page' : undefined}>Perspectives</a><a href={profile.linkedin}>LinkedIn <span aria-hidden="true">↗</span></a></nav>
    </header>
    <main id="main" class="shell"><slot /></main>
    <footer class="site-footer shell"><span>Manivannan Kalyanasundaram</span><a href={profile.linkedin}>Find me on LinkedIn <span aria-hidden="true">↗</span></a><a class="back-top" href="#main">Back to top <span aria-hidden="true">↑</span></a></footer>
  </body>
</html>
